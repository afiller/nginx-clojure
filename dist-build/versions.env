# ---------------------------------------------------------------------------
# nginx
# ---------------------------------------------------------------------------
# Stable branch is recommended for production. Check https://nginx.org/en/download.html
NGINX_VERSION=1.30.6
# PGP-verified 2026-10-19 against nginx-1.30.6.tar.gz.asc
# (Sergey Kandaurov, D678 6CE3 03D9 A902 2998  DC6C C846 4D54 9AF7 5C0A)
NGINX_SHA256=3cf46f5ed7504d460125866b7bea99fb357f31d887e2e63b35503310e9b8b6c8

# ---------------------------------------------------------------------------
# OpenSSL (only used when OPENSSL_MODE=static)
# ---------------------------------------------------------------------------
# 3.5.x is the current LTS line. Check https://openssl-library.org/source/
OPENSSL_VERSION=3.5.6
# PGP-verified 2026-07-28 against openssl-3.5.6.tar.gz.asc
# (OpenSSL <openssl@openssl.org>, BA54 73A2 B058 7B07 FB27  CF2D 2160 94DF D0CB 81EF)
OPENSSL_SHA256=deae7c80cba99c4b4f940ecadb3c3338b13cb77418409238e57d7f31f2a3b736

# zlib and PCRE2 are NOT built from source: nginx links the build image's
# zlib1g-dev / libpcre2-dev. Building them from source trips a GNU make 4.3
# jobserver bug (see Dockerfile) and their SONAMEs are stable everywhere.

# ---------------------------------------------------------------------------
# nginx-clojure module source
# ---------------------------------------------------------------------------
# Path (absolute, or relative to this file) to the checkout whose src/c holds
# the module. Defaults to this repository -- point it elsewhere to build a
# distribution from a different branch or worktree.
NGINX_CLOJURE_SRC=..
# Only used to name the resulting distribution directory. The module version
# actually compiled in comes from src/c/ngx_http_clojure_mem.h.
NGINX_CLOJURE_VERSION=0.6.1

# ---------------------------------------------------------------------------
# Build options
# ---------------------------------------------------------------------------

# static = OpenSSL is compiled into the nginx binary (portable, but every
#          OpenSSL CVE requires a rebuild of this tarball).
# system = link against the build image's libssl (binary then requires a
#          matching distro on the target -- set BASE_IMAGE accordingly!).
OPENSSL_MODE=static

# Base image for the Linux build. Its glibc must NOT be newer than the oldest
# production host's glibc -- the binary links the build image's glibc symbols.
#
#   debian:bullseye  glibc 2.31  -> EOL, its security mirror no longer serves
#                                   packages (apt fails with 404 since Oct 2026)
#   ubuntu:22.04     glibc 2.35  <-- current, supported targets: Ubuntu 22.04, 24.04
#   debian:bookworm  glibc 2.36  -> drops Ubuntu 22.04 (2.35)
#
# Ubuntu 20.04 (glibc 2.31) is no longer a target of this distribution.
# Do not bump this without re-checking the target hosts.
#
# With OPENSSL_MODE=system this MUST match the production distro exactly.
BASE_IMAGE=ubuntu:22.04

# Target platform for the Linux binary. On Apple Silicon this is emulated via
# QEMU and therefore slow (expect 15-30 min for a full static build).
BUILD_PLATFORM=linux/amd64

# Parallel compile jobs. Empty = number of CPUs in the container.
MAKE_JOBS=

# Compile nginx with --with-debug. The 0.6.0 upstream distribution had this
# enabled and nginx-clojure guards a lot of useful logging behind NGX_DEBUG.
# Costs a little throughput; keep it unless you are chasing the last percent.
WITH_DEBUG=yes

# Apply the two-line ngx_http_proxy_module patch that the nginx-clojure project
# maintains in its nginx fork (allows removing headers in a rewrite handler
# before proxy_pass). See README.md ("Der Proxy-Patch").
APPLY_PROXY_PATCH=yes
